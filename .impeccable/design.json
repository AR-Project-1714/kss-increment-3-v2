  "components": [
    {
      "name": "Primary Tool Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Aksi utama seperti Terapkan dan pemicu filter performa.",
      "html": "<button class=\"ds-btn-primary\" type=\"button\"><svg aria-hidden=\"true\" viewBox=\"0 0 24 24\"><path d=\"M5 12.5 9.5 17 19 7.5\"/></svg><span>Terapkan</span></button>",
      "css": ".ds-btn-primary{display:inline-flex;align-items:center;justify-content:center;gap:6px;padding:8px 14px;min-height:38px;border:1px solid var(--blue-main);border-radius:8px;background:var(--blue-main);color:var(--white-pure);font:500 12px Poppins,sans-serif;cursor:pointer;transition:background-color .2s ease,border-color .2s ease,box-shadow .2s ease,transform .16s ease}.ds-btn-primary svg{width:14px;height:14px;fill:none;stroke:currentColor;stroke-width:2;stroke-linecap:round;stroke-linejoin:round}.ds-btn-primary:hover{background:var(--blue-hover);border-color:var(--blue-hover)}.ds-btn-primary:focus-visible{outline:none;box-shadow:0 0 0 3px var(--blue-main-25)}.ds-btn-primary:active{background:var(--blue-active);transform:scale(.98)}"
    },
    {
      "name": "Secondary Tool Button",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "Aksi pendamping seperti ekspor dan membuka rincian.",
      "html": "<button class=\"ds-btn-secondary\" type=\"button\"><span>Buka Rincian</span><svg aria-hidden=\"true\" viewBox=\"0 0 24 24\"><path d=\"m9 6 6 6-6 6\"/></svg></button>",
      "css": ".ds-btn-secondary{display:inline-flex;align-items:center;justify-content:center;gap:6px;padding:8px 14px;border:1px solid var(--smooth-border);border-radius:8px;background:var(--white);color:var(--black-secondary);font:500 12px Poppins,sans-serif;cursor:pointer;transition:background-color .2s ease,border-color .2s ease,color .2s ease,transform .16s ease}.ds-btn-secondary svg{width:14px;height:14px;fill:none;stroke:currentColor;stroke-width:2;stroke-linecap:round;stroke-linejoin:round}.ds-btn-secondary:hover{background:var(--blue-main-5);border-color:var(--blue-main-25);color:var(--blue-main)}.ds-btn-secondary:focus-visible{outline:none;box-shadow:0 0 0 3px var(--blue-main-10)}.ds-btn-secondary:active{transform:scale(.98)}"
    },
    {
      "name": "Filter Field",
      "kind": "input",
      "refersTo": "input",
      "description": "Bidang filter periode, regu, shift, dan pencarian.",
      "html": "<label class=\"ds-field\"><span class=\"ds-field-label\">Regu</span><input class=\"ds-field-input\" type=\"text\" placeholder=\"Semua regu\"></label>",
      "css": ".ds-field{display:flex;flex-direction:column;gap:4px;font-family:Poppins,sans-serif}.ds-field-label{color:var(--black-secondary);font-size:10px;font-weight:500}.ds-field-input{min-width:150px;padding:8px 12px;border:1px solid var(--smooth-border);border-radius:8px;background:var(--white);color:var(--black);font:400 12px Poppins,sans-serif;outline:none;transition:border-color .2s ease,box-shadow .2s ease}.ds-field-input::placeholder{color:var(--muted)}.ds-field-input:hover{border-color:var(--divider)}.ds-field-input:focus-visible{border-color:var(--blue-main);box-shadow:0 0 0 3px var(--blue-main-10)}.ds-field-input:disabled{cursor:not-allowed;opacity:.65}"
    },
    {
      "name": "KPI Card",
      "kind": "card",
      "refersTo": "kpi-card",
      "description": "Pembuka pembacaan untuk angka utama, unit, delta, dan konteks.",
      "html": "<article class=\"ds-kpi-card\"><div class=\"ds-kpi-head\"><span class=\"ds-kpi-icon\"><svg aria-hidden=\"true\" viewBox=\"0 0 24 24\"><path d=\"M4 19V9m6 10V5m6 14v-7m4 7H2\"/></svg></span><span class=\"ds-kpi-label\">Total Tonase</span></div><div class=\"ds-kpi-row\"><strong class=\"ds-kpi-value\">24.680 <small>Ton</small></strong><span class=\"ds-kpi-delta\">+8,2%</span></div><span class=\"ds-kpi-note\">dibanding periode sebelumnya</span></article>",
      "css": ".ds-kpi-card{min-height:128px;display:flex;flex-direction:column;gap:10px;padding:16px 18px 14px;border:1px solid var(--smooth-border);border-radius:14px;background:var(--white);color:var(--black);box-shadow:0 2px 4px rgba(37,99,235,.07);font-family:Poppins,sans-serif}.ds-kpi-head,.ds-kpi-row{display:flex;align-items:center;gap:10px}.ds-kpi-row{justify-content:space-between;flex-wrap:wrap}.ds-kpi-icon{width:36px;height:36px;display:grid;place-items:center;border-radius:10px;background:var(--blue-main-10);color:var(--blue-main)}.ds-kpi-icon svg{width:16px;height:16px;fill:none;stroke:currentColor;stroke-width:2;stroke-linecap:round}.ds-kpi-label{color:var(--black-secondary);font-size:12px;font-weight:500}.ds-kpi-value{font-size:26px;line-height:1.1;font-weight:700;font-variant-numeric:tabular-nums}.ds-kpi-value small{margin-left:5px;color:var(--muted);font-size:12px;font-weight:500}.ds-kpi-delta{padding:3px 9px;border-radius:999px;background:var(--success-10);color:var(--success);font-size:11px;font-weight:600}.ds-kpi-note{color:var(--muted);font-size:10px}"
    },
    {
      "name": "Section Card",
      "kind": "card",
      "refersTo": "section-card",
      "description": "Wadah utama untuk ringkasan, grafik, tabel, dan rincian.",
      "html": "<section class=\"ds-section-card\"><header class=\"ds-section-header\"><div><h3>Tren Kuantum</h3><p>Enam bulan terakhir, Ton, MT, dan Teus tetap dilabeli sesuai sumber.</p></div></header><div class=\"ds-section-body\"><span class=\"ds-section-placeholder\">Area data atau grafik</span></div></section>",
      "css": ".ds-section-card{overflow:hidden;border:1px solid var(--smooth-border);border-radius:14px;background:var(--white);color:var(--black);box-shadow:0 1px 2px rgba(15,23,42,.04);font-family:Poppins,sans-serif}.ds-section-header{padding:16px 20px;border-bottom:1px solid var(--smooth-border)}.ds-section-header h3{margin:0;color:var(--black);font-size:15px;font-weight:600}.ds-section-header p{margin:2px 0 0;color:var(--black-secondary);font-size:10px;font-weight:400}.ds-section-body{min-height:96px;display:grid;place-items:center;padding:20px}.ds-section-placeholder{color:var(--muted);font-size:11px}"
    },
    {
      "name": "Success Status Chip",
      "kind": "chip",
      "refersTo": "status-success",
      "description": "Status persetujuan atau delta yang membaik.",
      "html": "<span class=\"ds-status-success\"><span class=\"ds-status-dot\" aria-hidden=\"true\"></span>Disetujui</span>",
      "css": ".ds-status-success{display:inline-flex;align-items:center;gap:6px;padding:3px 9px;border:1px solid var(--success);border-radius:999px;background:var(--success-10);color:var(--success);font:600 10px Poppins,sans-serif}.ds-status-dot{width:6px;height:6px;border-radius:50%;background:currentColor}"
    },
    {
      "name": "Sidebar Navigation Item",
      "kind": "nav",
      "refersTo": "nav-active",
      "description": "Item menu dengan ikon, label, hover lembut, dan state aktif yang jelas.",
      "html": "<a class=\"ds-nav-item is-active\" href=\"#\" aria-current=\"page\"><svg aria-hidden=\"true\" viewBox=\"0 0 24 24\"><rect x=\"4\" y=\"4\" width=\"6\" height=\"6\" rx=\"1\"/><rect x=\"14\" y=\"4\" width=\"6\" height=\"6\" rx=\"1\"/><rect x=\"4\" y=\"14\" width=\"6\" height=\"6\" rx=\"1\"/><rect x=\"14\" y=\"14\" width=\"6\" height=\"6\" rx=\"1\"/></svg><span>Dashboard</span></a>",
      "css": ".ds-nav-item{display:flex;align-items:center;gap:10px;padding:8px 10px;border-radius:8px;background:transparent;color:var(--muted);font:400 12px Poppins,sans-serif;text-decoration:none;transition:background-color .2s ease,color .2s ease}.ds-nav-item svg{width:16px;height:16px;fill:none;stroke:currentColor;stroke-width:1.8}.ds-nav-item:hover{background:var(--blue-main-5);color:var(--black-secondary)}.ds-nav-item.is-active{background:var(--blue-main-10);color:var(--blue-active);font-weight:500}.ds-nav-item:focus-visible{outline:none;box-shadow:0 0 0 3px var(--blue-main-10)}.ds-nav-item:active{background:var(--blue-main-10)}"
    },
    {
      "name": "Activity Tab",
      "kind": "nav",
      "refersTo": "tab-active",
      "description": "Salah satu dari tujuh kegiatan, lengkap dengan satuan dan semantik tab.",
      "html": "<button class=\"ds-activity-tab is-active\" type=\"button\" role=\"tab\" aria-selected=\"true\"><svg aria-hidden=\"true\" viewBox=\"0 0 24 24\"><path d=\"M4 8h16v10H4zM8 8V5h8v3\"/></svg><span>Bongkar</span><small>Ton</small></button>",
      "css": ".ds-activity-tab{display:inline-flex;min-width:140px;align-items:center;justify-content:center;gap:8px;padding:6px 12px;border:0;border-radius:8px;background:transparent;color:var(--black-secondary);font:500 12px Poppins,sans-serif;cursor:pointer;transition:color .2s ease,background-color .2s ease,transform .16s ease}.ds-activity-tab svg{width:14px;height:14px;fill:none;stroke:currentColor;stroke-width:1.8}.ds-activity-tab small{padding:2px 6px;border-radius:999px;background:var(--blue-main-5);color:var(--muted);font-size:9px}.ds-activity-tab:hover{background:var(--blue-main-10);color:var(--blue-main)}.ds-activity-tab.is-active{background:var(--blue-main);color:var(--white-pure)}.ds-activity-tab.is-active small{background:rgba(255,255,255,.18);color:var(--white-pure)}.ds-activity-tab:focus-visible{outline:none;box-shadow:0 0 0 3px var(--blue-main-25)}.ds-activity-tab:active{transform:scale(.98)}"
    }
  ],
  "narrative": {
    "northStar": "The Structured Operations Ledger",
    "overview": "Sistem ini menerjemahkan kepadatan spreadsheet operasional menjadi antarmuka terstruktur yang dapat dipindai cepat. Ia terasa tenang, presisi, dan praktis: permukaan terang atau gelap yang berlapis tipis, kartu ringkas, angka tabular, serta warna semantik yang dipakai untuk orientasi dan status—bukan dekorasi.\n\nMode utamanya adalah Operate. Dashboard membuka pembacaan langsung dengan tujuh kartu kegiatan dan laporan masuk. Kinerja Operasi melanjutkan dengan KPI, ringkasan kegiatan, serta analitik sebelum pengguna masuk ke Rincian Kegiatan. Poppins, Flaticon UICons, token tema, anatomi kartu, dan perilaku responsif tetap menjadi satu dunia visual lintas modul.",
    "keyCharacteristics": [
      "Padat namun berjarak teratur, seperti lembar kerja yang sudah disusun untuk keputusan cepat.",
      "Hierarki angka-ke-konteks: nilai utama tegas, satuan dan keterangan lebih tenang tetapi tetap terbaca.",
      "Kartu putih atau slate dengan batas halus, sudut membulat, dan bayangan rendah.",
      "Aksen biru untuk orientasi dan aksi; hijau, jingga, merah, cyan, dan palet grafik hanya untuk makna data.",
      "Paritas light/dark dan keterbacaan teks sekunder adalah bagian dari sistem, bukan variasi kosmetik."
    ],
    "rules": [
      { "name": "The Semantic Color Rule", "body": "Warna non-netral harus menjelaskan aksi, status, kategori, atau seri data; jangan menggunakannya sebagai hiasan bebas.", "section": "colors" },
      { "name": "The Theme Pair Rule", "body": "Semua warna implementasi harus berasal dari variabel tema yang memiliki pasangan light/dark; jangan menambahkan nilai warna langsung pada permukaan baru.", "section": "colors" },
      { "name": "The Readable Muted Rule", "body": "Teks sekunder dan muted boleh lebih tenang, tetapi tidak boleh menjadi abu-abu yang terlalu redup untuk dibaca pada light maupun dark mode.", "section": "typography" },
      { "name": "The Progressive Ledger Rule", "body": "Mulai Dashboard dari tujuh kegiatan, lalu arahkan ke laporan masuk; pada Kinerja Operasi gunakan KPI → ringkasan kegiatan → analitik → detail. Jangan mendahulukan tabel panjang sebelum ringkasannya.", "section": "layout" },
      { "name": "The Earned Elevation Rule", "body": "Bayangan kuat hanya untuk elemen yang mengambang, menutup, atau menuntut fokus sementara.", "section": "elevation" }
    ],
    "dos": [
      "Do gunakan token tema, Poppins, Flaticon UICons, dan anatomi kartu incumbent untuk semua ekstensi.",
      "Do pertahankan Dashboard yang activity-first dan Kinerja Operasi yang KPI/summary-first sebelum analitik dan rincian.",
